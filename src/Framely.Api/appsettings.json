{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Media": {
    "RootPath": "App_Data/media",
    "OriginRequestPath": "/media",
    "PublicBaseUrl": "/media",
    "MaxUploadBytes": 10485760
  },
  "Feed": {
    "PageSize": 25,
    "MaxTimelineLength": 1000,
    "BackfillCount": 50
  }
}
